			"bytes": 272810,
			"contentType": "application/javascript"
		},
		{
			"path": "dist/frontend/assets/index.css",
			"sha256": "sha256:882f9c8c9bbb7c889622cf62f8b472a0f632b6c5af2edfd823bb212957fda647",
			"bytes": 6019,
			"contentType": "text/css"
		}
	]
}
